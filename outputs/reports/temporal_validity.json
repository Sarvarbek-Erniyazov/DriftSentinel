  "dropped_anchors": {
    "ub04_discharge_codes": {
      "reason": "discharge_disposition_id 27/28/29 and admission_source_id 25/26 are plausibly late additions tied to the UB-04 form (which replaced UB-92 for institutional claims in 2007), but per-code introduction dates could not be verified from a primary source. Using them would assert an unverified date, which is precisely the failure mode this remediation exists to remove. Dropped by the pre-registered rule, not by result.\n"
    },
    "icd9_subcode_anchors": {
      "reason": "Higher-resolution ICD-9 anchors (e.g. the 585.1-585.6 chronic kidney disease staging codes introduced 1 October 2005) are unusable because this dataset TRUNCATES diagnosis codes to the 3-character category level for everything except the 250.x diabetes family (20,848 of 303,496 non-missing diag entries carry a decimal, and all but one are 250.x). 585.1-585.6 all collapse to \"585\". Only category-level codes dated inside the window survive, which is why A4 is V85 and nothing else.\n"
    }
  },
